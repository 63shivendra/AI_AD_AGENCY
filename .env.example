# ── Database ─────────────────────────────────────────────────────
# Dev: SQLite file next to the schema. Prod: point at Supabase/Postgres
# and change the provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# ── Agency access ────────────────────────────────────────────────
# Passcode for the dashboard. CHANGE THIS before any public deploy.
AGENCY_PASSCODE="kanpur2026"
# Shown in the sidebar, portal, funnel and standee. Rebrand in one place.
NEXT_PUBLIC_AGENCY_NAME="Growth Engine"
# Public origin used for the printed QR codes. Leave blank to auto-detect the LAN IP.
NEXT_PUBLIC_APP_URL=""

# ── AI (optional) ────────────────────────────────────────────────
# With a key: Gemini writes the Hinglish hooks and reviews.
# Without a key: the built-in playbook writer runs offline — the demo still works.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ── Video rendering ──────────────────────────────────────────────
# "local" = bundled ffmpeg on this machine (real 1080x1920 MP4, works offline)
# "modal" = your Modal.com GPU worker (set MODAL_RENDER_URL)
RENDER_DRIVER="local"
MODAL_RENDER_URL=""

# ── Trend-reel presenter (hybrid) ───────────────────────────────
# auto = owner clip > HeyGen avatar > stock narrator.
# Drop a real owner clip at public/assets/presenters/<client-slug>/owner.mp4
# (vertical, 15–30s, same script as the reel) for the most realistic result.
# Or configure HeyGen for a synthetic, lip-synced presenter — the avatar path
# also drops a circular talking-head PiP over the reel's b-roll (manifest
# presenter.pip: "avatar" | "all" | "none").
TREND_PRESENTER="auto"
HEYGEN_API_KEY=""
HEYGEN_AVATAR_ID=""
HEYGEN_VOICE_ID=""
HEYGEN_VOICE_SPEED="1"

# ── Object storage (optional, reserved) ──────────────────────────
# Renders are written to /public/renders by default. These keys are read by
# the settings page but no upload adapter is wired yet — see README.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# ── Meta / TikTok publishing (optional) ──────────────────────────
# Without these, "Publish" is simulated (sandbox) so demos never spend money.
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
TIKTOK_ACCESS_TOKEN=""
